# ─────────────────────────────────────────────
# LUXE Ecommerce — Server Environment Variables
# Copy this file to `.env` and fill in real values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/luxe-ecommerce

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary (image uploads) — optional in dev, required in prod
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer) — optional in dev (falls back to console / Ethereal)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=LUXE Store <no-reply@luxe.com>

# Frontend origin (CORS + email links)
FRONTEND_URL=http://localhost:5173

# Razorpay (test-mode checkout) — get TEST keys from
# https://dashboard.razorpay.com → Settings → API Keys (toggle "Test Mode").
# Leave blank to keep demo checkout (orders still work, no real gateway).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_CURRENCY=INR
